<svg class="lucide lucide-music" xmlns="http://www.w3.org/2000/svg" width="400" height="250" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <style>
    .lucide-music:hover circle { animation: note-bounce 0.8s ease infinite; }
    .lucide-music:hover path { animation: note-wave 1s ease infinite; }
    @keyframes note-bounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
    @keyframes note-wave { 0%,100% { transform: rotate(0deg); } 25% { transform: rotate(3deg); } 75% { transform: rotate(-3deg); } }
  </style>
  <path d="M9 18V5l12-2v13"/>
  <circle cx="6" cy="18" r="3"/>
  <circle cx="18" cy="16" r="3"/>
</svg>