<svg class="lucide lucide-shield-check" xmlns="http://www.w3.org/2000/svg" width="400" height="250" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <style>
    .lucide-shield-check:hover path:first-child { animation: shield-glow 1s ease infinite; }
    .lucide-shield-check:hover path:last-child { animation: check-draw 0.6s ease; }
    @keyframes shield-glow { 0%,100% { filter: drop-shadow(0 0 0px #0D9488); } 50% { filter: drop-shadow(0 0 8px #0D9488); } }
    @keyframes check-draw { 0% { stroke-dashoffset: 20; } 100% { stroke-dashoffset: 0; } }
  </style>
  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
  <path d="m9 12 2 2 4-4"/>
</svg>